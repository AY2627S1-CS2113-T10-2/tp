%%{init: {'theme': 'default', 'sequence': {'actorMargin': 85, 'messageMargin': 45}}}%%
sequenceDiagram
    actor user as User
    participant ui as :Ui
    participant main as :Main
    participant cmd as :AddCommand
    participant app as :Application
    participant list as :ApplicationList
    participant storage as :Storage

    user->>main: Enter 1
    main->>main: promptNonEmpty("Company:")
    activate main
    main->>ui: showPrompt(...)
    activate ui
    deactivate ui
    main->>ui: readCommand()
    activate ui
    ui-->>main: "Google"
    deactivate ui
    deactivate main
    main->>main: promptNonEmpty("Role:")
    activate main
    main->>ui: showPrompt(...)
    activate ui
    deactivate ui
    main->>ui: readCommand()
    activate ui
    ui-->>main: "SWE Intern"
    deactivate ui
    deactivate main
    main->>main: promptDeadline()
    activate main
    main->>ui: showPrompt(...)
    activate ui
    deactivate ui
    main->>ui: readCommand()
    activate ui
    ui-->>main: "2026-11-15"
    deactivate ui
    deactivate main
    main->>main: promptOptional("Company Portal Link:")
    activate main
    main->>ui: showPrompt(...)
    activate ui
    deactivate ui
    main->>ui: readCommand()
    activate ui
    ui-->>main: "https://careers.google.com"
    deactivate ui
    deactivate main
    main->>main: promptOptional("Contact Email:")
    activate main
    main->>ui: showPrompt(...)
    activate ui
    deactivate ui
    main->>ui: readCommand()
    activate ui
    ui-->>main: "recruiter@google.com"
    deactivate ui
    deactivate main
    main->>main: promptOptional("Notes:")
    activate main
    main->>ui: showPrompt(...)
    activate ui
    deactivate ui
    main->>ui: readCommand()
    activate ui
    ui-->>main: "OA passed"
    deactivate ui
    deactivate main

    main->>cmd: new AddCommand(...)
    activate cmd
    cmd-->>main: addCommand
    deactivate cmd

    main->>cmd: execute(...)
    activate cmd
    cmd->>app: new Application(...)
    activate app
    app-->>cmd: application
    deactivate app
    cmd->>list: add(application)
    activate list
    deactivate list
    cmd->>storage: save(applications)
    activate storage
    deactivate storage
    cmd->>ui: showMessage("Application added")
    activate ui
    ui-->>user: Confirmation message
    deactivate ui
    deactivate cmd
