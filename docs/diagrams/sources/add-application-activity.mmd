%%{init: {'theme': 'neutral'}}%%
flowchart LR
    Start(( )):::start --> MergePrompt{ }
    MergePrompt --> Prompt("Prompt company, role,<br/>deadline, portal, email, notes")
    Prompt --> Cancelled{"User typed cancel<br/>or input ended?"}
    Cancelled -->|"[yes]"| ShowCancel("Show 'Cancelled.<br/>No changes were made.'")
    Cancelled -->|"[no]"| Validate{"Valid required<br/>fields & date?"}
    Validate -->|"[valid]"| Create("Create Application<br/>& add to list")
    Validate -->|"[else]"| ShowErr("Show error<br/>message")
    ShowErr --> MergePrompt
    Create --> Save("Save applications<br/>to storage")
    Save --> Saved{"Save<br/>succeeded?"}
    Saved -->|"[yes]"| Show("Display confirmation<br/>message")
    Saved -->|"[else]"| Rollback("Remove the new application<br/>& show error")
    Show --> MergeEnd{ }
    Rollback --> MergeEnd
    ShowCancel --> MergeEnd
    MergeEnd --> End(("●")):::finish
    classDef start fill:#000,stroke:#000
    classDef finish fill:#fff,stroke:#000,stroke-width:4px,font-size:26px
