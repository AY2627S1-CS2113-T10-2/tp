%%{init: {'theme': 'neutral'}}%%
classDiagram
    direction TB
    class Main {
        -ui : Ui
        -storage : Storage
        -applications : ApplicationList
        -deadlineWarnings : DeadlineWarnings
        -history : CommandHistory
        +run() void
        +parseCommand(option : String) Command
    }
    class Ui {
        -scanner : Scanner
        +showWelcome() void
        +showMenu(applications : ApplicationList) void
        +showMenuOptions() void
        +showEditMenu() void
        +showMessage(message : String) void
        +showError(errorMessage : String) void
        +showPrompt(prompt : String) void
        +readCommand() String
        +showGoodbye() void
    }
    class Storage {
        -filePath : String
        +save(applications : ApplicationList) void
        +load() ApplicationList
    }
    class ApplicationList {
        -applications : ArrayList~Application~
        +add(app : Application) void
        +getAll() List~Application~
    }
    class DeadlineWarnings {
        +show(applications : ApplicationList, ui : Ui) void
    }
    class CommandParser {
        +parse(input : String, history : CommandHistory)$ Command
    }
    class CommandHistory {
        -history : Deque~UndoableCommand~
        +record(command : Command) void
        +peek() UndoableCommand
        +pop() UndoableCommand
        +isEmpty() boolean
    }
    class Command["{abstract}<br/>Command"] {
        #isExit : boolean
        +execute(applications : ApplicationList, ui : Ui, storage : Storage)* void
        +isExit() boolean
    }
    class UndoableCommand["{abstract}<br/>UndoableCommand"] {
        -hasChanged : boolean
        #markChanged() void
        +hasChanged() boolean
        #saveOrRollback(applications : ApplicationList, storage : Storage) void
        +undo(applications : ApplicationList)* String
    }
    Main "1" --> "1" Ui : uses ▶
    Main "1" --> "1" Storage : uses ▶
    Main "1" --> "1" ApplicationList : manages ▶
    Main "1" *-- "1" DeadlineWarnings
    Main "1" *-- "1" CommandHistory
    Main ..> CommandParser : calls ▶
    Main ..> Command : executes ▶
    CommandParser ..> Command : creates ▶
    Command <|-- UndoableCommand
    UndoableCommand <|-- AddCommand
    UndoableCommand <|-- DeleteCommand
    UndoableCommand <|-- EditCommand
    UndoableCommand <|-- RecruitmentStageCommand
    UndoableCommand <|-- MarkCommand
    Command <|-- UndoCommand
    Command <|-- ListCommand
    Command <|-- ViewCommand
    Command <|-- SearchCommand
    Command <|-- SortCommand
    Command <|-- FindCommand
    Command <|-- TodayCommand
    Command <|-- HelpCommand
    Command <|-- ExitCommand
