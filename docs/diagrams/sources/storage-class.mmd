%%{init: {'theme': 'default'}}%%
classDiagram
    direction LR
    class Main:::ctrl {
        -loadApplications(ui : Ui, storage : Storage)$ ApplicationList
    }
    class Storage:::store {
        -filePath : String
        -saveBlocked : boolean
        -backupPending : boolean
        -loadWarnings : List~String~
        +save(applications : ApplicationList) void
        +load() ApplicationList
        +ensureWritable() void
        +getLoadWarnings() List~String~
        +getBackupFilePath() String
        +isBackupPending() boolean
        -writeAtomically(target : Path, lines : List~String~) void
        -backUpOriginalIfNeeded(path : Path) void
        -parseRecord(lineIndex : int, line : String) Application
    }
    class ApplicationList:::model {
        -applications : ArrayList~Application~
        +getAll() List~Application~
        +add(app : Application) void
    }
    class Application:::model {
        -company : String
        -role : String
        -isCompleted : boolean
        -recruitmentStage : RecruitmentStage
        -deadline : LocalDate
        -portalLink : String
        -email : String
        -notes : String
    }
    Main "1" --> "1" Storage : uses ▶
    Storage ..> ApplicationList : saves / loads ▶
    ApplicationList "1" *-- "0..*" Application : owns ▶
    Storage ..> Application : serializes / parses ▶
    classDef ctrl fill:#fdf2ff,stroke:#c26bdb,stroke-width:2px
    classDef io fill:#eefcf6,stroke:#2bb58a,stroke-width:2px
    classDef store fill:#fff5ec,stroke:#f08c3a,stroke-width:2px
    classDef model fill:#eafcff,stroke:#17a2b8,stroke-width:2px
    classDef enum fill:#f1ecff,stroke:#8e6bd8,stroke-width:2px
    classDef cmd fill:#fff1f1,stroke:#ef5b5b,stroke-width:2px
    classDef undoable fill:#fffbe6,stroke:#e6b800,stroke-width:2px
    classDef util fill:#eefaf0,stroke:#4caf50,stroke-width:2px
