%%{init: {'theme': 'neutral'}}%%
flowchart LR
    Start(( )):::start --> PromptIdx("Prompt & validate<br/>index")
    PromptIdx --> PromptField("Show edit menu &<br/>prompt field choice (1-8)")
    PromptField --> Branch{"Field choice"}
    Branch -->|"[1: Company]"| UpdCo("Update company") --> Merge{ }
    Branch -->|"[2: Role]"| UpdRole("Update role") --> Merge
    Branch -->|"[3: Recruitment stage]"| UpdStage("Update recruitment stage") --> Merge
    Branch -->|"[4: Deadline]"| UpdDue("Update deadline") --> Merge
    Branch -->|"[5: Portal Link]"| UpdPort("Update portal link") --> Merge
    Branch -->|"[6: Email]"| UpdMail("Update email") --> Merge
    Branch -->|"[7: Notes]"| UpdNote("Update notes") --> Merge
    Branch -->|"[8: All]"| UpdAll("Update all fields") --> Merge
    Branch -->|"[else]"| ShowErr("Show 'Invalid field choice'") --> MergeEnd{ }
    Merge --> Changed{"Any value<br/>different?"}
    Changed -->|"[no]"| NoChange("Show 'No changes made'") --> MergeEnd
    Changed -->|"[yes]"| Save("Save applications<br/>to storage")
    Save --> Saved{"Save<br/>succeeded?"}
    Saved -->|"[yes]"| Confirm("Show confirmation<br/>message")
    Saved -->|"[else]"| Rollback("Restore old values<br/>& show error")
    Confirm --> MergeEnd
    Rollback --> MergeEnd
    MergeEnd --> End(("●")):::finish
    classDef start fill:#000,stroke:#000
    classDef finish fill:#fff,stroke:#000,stroke-width:4px,font-size:26px
