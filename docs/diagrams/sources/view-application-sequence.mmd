sequenceDiagram
    actor user as User
    participant ui as :Ui
    participant main as :Main
    participant parser as :CommandParser
    participant cmd as :ViewCommand
    participant list as :ApplicationList
    participant app as :Application

    user->>main: Enter "view 1"
    main->>parser: parse("view 1", history)
    activate parser
    parser->>cmd: ViewCommand.parse("1")
    activate cmd
    cmd-->>parser: viewCommand
    deactivate cmd
    parser-->>main: viewCommand
    deactivate parser
    main->>cmd: execute(...)
    activate cmd

    alt 0 <= targetIndex < size
        cmd->>list: get(0)
        activate list
        list-->>cmd: application
        deactivate list
        cmd->>app: getCompany()
        activate app
        app-->>cmd: "Google"
        deactivate app
        cmd->>app: getRole()
        activate app
        app-->>cmd: "SWE Intern"
        deactivate app
        cmd->>app: getRecruitmentStage()
        activate app
        app-->>cmd: ACCEPTED
        deactivate app
        cmd->>app: isCompleted()
        activate app
        app-->>cmd: false
        deactivate app
        cmd->>ui: showMessage(card)
        activate ui
        ui-->>user: Structured card display
        deactivate ui
        cmd-->>main: 
    else invalid index
        cmd-->>main: throw JobSeekException
    end

    deactivate cmd
