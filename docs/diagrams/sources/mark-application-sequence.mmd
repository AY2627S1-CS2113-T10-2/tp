%%{init: {'theme': 'default', 'themeCSS': '.actor-line{stroke-dasharray:6 5;} .loopLine{stroke-dasharray:none;}', 'sequence': {'mirrorActors': false, 'actorMargin': 60, 'messageMargin': 28}}}%%
sequenceDiagram
    actor user as User
    participant main as :Main
    participant ui as :Ui
    participant history as :CommandHistory
    participant list as :ApplicationList
    participant app as :Application
    participant storage as :Storage

    user->>main: 5 (mark) or 6 (unmark)
    main->>main: promptApplicationIndex()
    activate main
    main->>ui: showPrompt("Enter application index to mark as completed:")
    main->>ui: readCommand()
    activate ui
    ui-->>main: "1"
    deactivate ui
    create participant cmd as :MarkCommand
    main->>cmd: new MarkCommand(0, true)
    deactivate main
    main->>storage: ensureWritable()
    main->>cmd: execute(applications, ui, storage)
    activate cmd
    cmd->>list: isValidIndex(0)
    activate list
    list-->>cmd: true
    deactivate list
    cmd->>list: get(0)
    activate list
    list-->>cmd: application
    deactivate list
    cmd->>app: isCompleted()
    activate app
    app-->>cmd: false
    deactivate app

    alt application already has the requested state
        cmd->>ui: showMessage("This application is already marked as completed...")
        activate ui
        ui-->>user: Status message
        deactivate ui
    else state changes
        cmd->>app: setCompleted(true)
        cmd->>cmd: markChanged()
        cmd->>cmd: saveOrRollback(applications, storage)
        activate cmd
        cmd->>storage: save(applications)
        deactivate cmd
        cmd->>ui: showMessage("Nice! I've marked this application as completed...")
        activate ui
        ui-->>user: Confirmation message
        deactivate ui
    end
    cmd-->>main:
    deactivate cmd
    main->>history: record(markCommand)
