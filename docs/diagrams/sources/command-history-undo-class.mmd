%%{init: {'theme': 'default'}}%%
classDiagram
    direction TB
    class Command["{abstract}<br/>Command"]:::cmd {
        #isExit : boolean
        +execute(applications : ApplicationList, ui : Ui, storage : Storage)* void
        +isExit() boolean
    }
    class UndoableCommand["{abstract}<br/>UndoableCommand"]:::undoable {
        -hasChanged : boolean
        #markChanged() void
        +hasChanged() boolean
        #saveOrRollback(applications : ApplicationList, storage : Storage) void
        +undo(applications : ApplicationList)* String
    }
    class CommandHistory:::util {
        -history : Deque~UndoableCommand~
        +record(command : Command) void
        +peek() UndoableCommand
        +pop() UndoableCommand
        +isEmpty() boolean
    }
    class UndoCommand:::cmd {
        -history : CommandHistory
        +UndoCommand(history : CommandHistory)
        +execute(applications : ApplicationList, ui : Ui, storage : Storage) void
    }
    class ApplicationListSnapshot:::util {
        -originals : List~Application~
        -values : List~Application~
        ~ApplicationListSnapshot(applications : ApplicationList)
        ~restore(applications : ApplicationList) void
    }
    class ApplicationList:::model {
        +replaceAll(newContents : Collection~Application~) void
    }
    Command <|-- UndoableCommand
    Command <|-- UndoCommand
    UndoableCommand <|-- AddCommand
    UndoableCommand <|-- DeleteCommand
    UndoableCommand <|-- EditCommand
    UndoableCommand <|-- RecruitmentStageCommand
    UndoableCommand <|-- MarkCommand
    CommandHistory "1" o-- "*" UndoableCommand : stores ▶
    UndoCommand "1" --> "1" CommandHistory : reads ▶
    UndoCommand ..> ApplicationListSnapshot : creates ▶
    ApplicationListSnapshot ..> ApplicationList : restores ▶
    class AddCommand:::undoable
    class DeleteCommand:::undoable
    class EditCommand:::undoable
    class RecruitmentStageCommand:::undoable
    class MarkCommand:::undoable
