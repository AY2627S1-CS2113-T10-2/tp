%%{init: {'theme': 'neutral'}}%%
flowchart LR
    Start(( )):::start --> Init("Initialize UI<br/>& Storage")
    Init --> Load("Load applications")
    Load --> CheckLoad{"Load<br/>success?"}
    CheckLoad -->|"[yes]"| Warn("Check deadlines<br/>& show menu")
    CheckLoad -->|"[no]"| Fallback("Show error, use empty list<br/>& block changes")
    Fallback --> Warn
    Warn --> MergeRead{ }
    MergeRead --> Read("Read & execute<br/>command")
    Read --> CheckExit{"Exit<br/>command?"}
    CheckExit -->|"[no]"| MergeRead
    CheckExit -->|"[yes]"| End(("●")):::finish
    classDef start fill:#000,stroke:#000
    classDef finish fill:#fff,stroke:#000,stroke-width:4px,font-size:26px
